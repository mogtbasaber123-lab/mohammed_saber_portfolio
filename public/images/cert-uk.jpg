<svg width="1000" height="700" viewBox="0 0 1000 700" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="1000" height="700" fill="#F8FAFC"/>
  <rect x="30" y="30" width="940" height="640" rx="12" fill="#FFFFFF" stroke="#1D4ED8" stroke-width="6"/>
  <rect x="45" y="45" width="910" height="610" rx="8" fill="none" stroke="#94A3B8" stroke-width="1.5"/>

  <rect x="470" y="80" width="60" height="60" fill="#1D4ED8" rx="8"/>
  <text x="500" y="120" font-family="system-ui, sans-serif" font-size="32" font-weight="900" fill="#FFFFFF" text-anchor="middle">UK</text>

  <text x="500" y="210" font-family="Georgia, serif" font-size="30" font-weight="bold" fill="#0F172A" text-anchor="middle">BRITISH ACCOUNTING FELLOWSHIP</text>
  <text x="500" y="245" font-family="system-ui, sans-serif" font-size="16" font-weight="600" fill="#1D4ED8" text-anchor="middle" letter-spacing="3">CHARTERED PROFESSIONAL QUALIFICATION (UNITED KINGDOM)</text>

  <line x1="200" y1="270" x2="800" y2="270" stroke="#1D4ED8" stroke-width="2"/>

  <text x="500" y="330" font-family="Georgia, serif" font-size="20" fill="#475569" text-anchor="middle">It is hereby accredited that</text>
  <text x="500" y="380" font-family="system-ui, sans-serif" font-size="34" font-weight="800" fill="#0F172A" text-anchor="middle">MOHAMMED SABER</text>
  <text x="500" y="425" font-family="Georgia, serif" font-size="20" fill="#475569" text-anchor="middle">has met all requirements and demonstrated mastery to be admitted as a</text>
  <text x="500" y="470" font-family="system-ui, sans-serif" font-size="25" font-weight="700" fill="#1D4ED8" text-anchor="middle">FELLOW OF THE CHARTERED ACCOUNTING COUNCIL</text>

  <circle cx="200" cy="560" r="45" fill="#1E40AF"/>
  <text x="200" y="565" font-family="system-ui, sans-serif" font-size="12" font-weight="bold" fill="#FFFFFF" text-anchor="middle">CHARTERED</text>
</svg>