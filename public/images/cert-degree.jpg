<svg width="1000" height="700" viewBox="0 0 1000 700" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="1000" height="700" fill="#F8FAFC"/>
  <!-- Certificate Border -->
  <rect x="30" y="30" width="940" height="640" rx="12" fill="#FFFFFF" stroke="#0F172A" stroke-width="8"/>
  <rect x="50" y="50" width="900" height="600" rx="8" fill="none" stroke="#D97706" stroke-width="2" stroke-dasharray="10 5"/>

  <!-- Header Watermark/Logo -->
  <circle cx="500" cy="140" r="50" fill="#FEF3C7" stroke="#D97706" stroke-width="3"/>
  <path d="M480 145 L 500 125 L 520 145 M500 125 L 500 160" stroke="#D97706" stroke-width="4" stroke-linecap="round"/>

  <text x="500" y="230" font-family="Georgia, serif" font-size="32" font-weight="bold" fill="#0F172A" text-anchor="middle">SUDAN ACADEMY FOR BANKING &amp; FINANCIAL SCIENCES</text>
  <text x="500" y="270" font-family="system-ui, sans-serif" font-size="18" font-weight="600" fill="#D97706" text-anchor="middle" letter-spacing="4">DEPARTMENT OF MANAGEMENT &amp; ACCOUNTING</text>

  <line x1="250" y1="295" x2="750" y2="295" stroke="#E2E8F0" stroke-width="2"/>

  <text x="500" y="340" font-family="Georgia, serif" font-size="22" font-style="italic" fill="#475569" text-anchor="middle">This is to certify that</text>
  <text x="500" y="390" font-family="system-ui, sans-serif" font-size="36" font-weight="800" fill="#0F172A" text-anchor="middle">MOHAMMED SABER</text>
  <text x="500" y="435" font-family="Georgia, serif" font-size="22" font-style="italic" fill="#475569" text-anchor="middle">has been awarded the degree of</text>
  <text x="500" y="480" font-family="system-ui, sans-serif" font-size="26" font-weight="700" fill="#1D4ED8" text-anchor="middle">BACHELOR IN FINANCIAL &amp; BANKING STUDIES</text>
  <text x="500" y="520" font-family="system-ui, sans-serif" font-size="20" font-weight="600" fill="#059669" text-anchor="middle">Graduation Grade: Very Good (Oct 2015 – Jan 2020)</text>

  <!-- Seal -->
  <circle cx="200" cy="580" r="45" fill="#059669" opacity="0.9"/>
  <text x="200" y="585" font-family="system-ui, sans-serif" font-size="13" font-weight="bold" fill="#FFFFFF" text-anchor="middle">OFFICIAL SEAL</text>

  <!-- Signatures -->
  <line x1="700" y1="590" x2="850" y2="590" stroke="#0F172A" stroke-width="2"/>
  <text x="775" y="615" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="#475569" text-anchor="middle">Academic Registrar</text>
</svg>